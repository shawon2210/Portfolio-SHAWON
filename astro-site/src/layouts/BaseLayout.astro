---
import { PERSONAL_INFO, SECTION_SEO } from '../lib/portfolio';
import SmoothScroll from '../components/SmoothScroll';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const home = SECTION_SEO.home;
const { title = home.title, description = home.description } = Astro.props;

const keywords = home.keywords.join(', ');
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://shawon.dev').href;
const ogImage = new URL('/og-image.png', Astro.site ?? 'https://shawon.dev').href;

const NAV_LINKS = [
  { label: 'Top', href: '#top' },
  { label: 'About', href: '#about' },
  { label: 'Stats', href: '#stats' },
  { label: 'Work', href: '#work' },
  { label: 'Contact', href: '#contact' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${Astro.site}#website`,
      url: `${Astro.site}`,
      name: `${PERSONAL_INFO.name} — Portfolio`,
      description: `Software engineering portfolio of ${PERSONAL_INFO.name}.`,
      inLanguage: 'en-US',
      publisher: { '@id': `${Astro.site}#person` },
    },
    {
      '@type': 'Person',
      '@id': `${Astro.site}#person`,
      name: PERSONAL_INFO.name,
      alternateName: PERSONAL_INFO.shortName,
      jobTitle: PERSONAL_INFO.title,
      description: PERSONAL_INFO.bio,
      url: `${Astro.site}`,
      image: ogImage,
      email: `mailto:${PERSONAL_INFO.email}`,
      address: {
        '@type': 'PostalAddress',
        addressLocality: PERSONAL_INFO.location,
      },
      sameAs: [PERSONAL_INFO.githubUrl, PERSONAL_INFO.linkedinUrl],
    },
    {
      '@type': 'ProfilePage',
      '@id': `${canonical}#webpage`,
      url: canonical,
      name: title,
      description,
      isPartOf: { '@id': `${Astro.site}#website` },
      about: { '@id': `${Astro.site}#person` },
      inLanguage: 'en-US',
    },
  ],
};
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content={PERSONAL_INFO.name} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    <meta name="theme-color" content="#090b11" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={`${PERSONAL_INFO.shortName} — Portfolio`} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
    />
  </head>

  <body class="bg-canvas text-heading antialiased">
    <a
      href="#hero"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:rounded-md focus:bg-primary focus:px-4 focus:py-2 focus:text-on-primary"
    >
      Skip to content
    </a>

    <header class="fixed inset-x-0 top-0 z-40 border-b border-border-glass bg-canvas/70 backdrop-blur-md">
      <nav
        aria-label="Primary"
        class="mx-auto flex items-center justify-between px-gutter py-4"
        style="max-width: var(--container-wide)"
      >
        <a href="#hero" class="font-display text-sm font-bold tracking-tight text-heading">
          {PERSONAL_INFO.shortName}
          <span class="text-primary">.</span>
        </a>

        <ul class="hidden items-center gap-6 text-xs font-medium tracking-wide text-body xs:flex">
          {
            NAV_LINKS.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="transition-colors duration-200 hover:text-heading focus-visible:text-heading"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>

        <a
          href={`mailto:${PERSONAL_INFO.email}`}
          class="rounded-pill border border-border-glass px-4 py-2 text-xs font-semibold text-heading transition-colors duration-200 hover:border-border-hover hover:text-primary"
        >
          Get in touch
        </a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="border-t border-border-glass px-gutter py-10 text-center text-xs text-body">
      <p>
        © {new Date().getFullYear()} {PERSONAL_INFO.name}. Built with Astro.
      </p>
    </footer>

    <SmoothScroll client:load />
  </body>
</html>