---
import { PROJECTS, WORK_EXPERIENCE, CERTIFICATES, SKILL_CATEGORIES } from '../lib/portfolio';

/**
 * Every number below is derived from portfolioData at build time, so a stat can
 * never drift from the content it claims to measure. Nothing is hardcoded.
 */
const stats = [
  { label: 'Projects', value: PROJECTS.length, caption: 'systems documented' },
  { label: 'Roles', value: WORK_EXPERIENCE.length, caption: 'professional experiences' },
  {
    label: 'Technologies',
    value: SKILL_CATEGORIES.reduce((total, category) => total + category.skills.length, 0),
    caption: 'across core disciplines',
  },
  { label: 'Certificates', value: CERTIFICATES.length, caption: 'verified credentials' },
];
---

<section id="stats" class="stats-section section-shell">
  <div class="mx-auto" style="max-width: var(--container-wide)">
    <div class="section-heading reveal">
      <p class="eyebrow"><span>03</span> / THE PRACTICE</p>
      <h2>Small details. <span>Solid systems.</span></h2>
    </div>
    <dl class="stats-grid">
      {
        stats.map((stat) => (
          <div class="stat-card reveal">
            <dt>{stat.label}</dt>
            <dd class="count-up" data-count={stat.value}>0</dd>
            <p>{stat.caption}</p>
          </div>
        ))
      }
    </dl>
  </div>
</section>