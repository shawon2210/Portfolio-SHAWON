# This project is fully static and runs entirely in the browser.
#
# No API keys, secrets, or environment variables are required to run it.
# This file exists only so that any future server-side or AI-backed
# integration has a documented place to live.
#
# Vite exposes variables prefixed with VITE_ to the client bundle via
# import.meta.env.VITE_*. Never commit real secrets to this file.

# VITE_APP_URL: Public URL the site is deployed to. Used for canonical
# links and social sharing metadata.
# VITE_APP_URL="https://example.com"
